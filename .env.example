# Copy to .env (gitignored) only to run a skill's commands by hand; load it with
#   set -a; . ./.env; set +a
# Every private value lives in Bitwarden Secrets Manager (BWS), read by name (skills/27, skills/30). A
# variable below overrides the BWS secret named in its comment; leave it blank to read BWS.
# No workflow in this repository reads any of them: CI runs on GitHub-hosted runners with only
# the read-only GITHUB_TOKEN, so it needs no BWS_ACCESS_TOKEN Actions secret.

# The BWS machine account's (or the owner's) access token. Needed whenever a value below is
# blank. On the owner's hosts it is in ~/.bws_token.
BWS_ACCESS_TOKEN=

# Tailscale addresses used by skills/syncthing-pair.
# BWS secret syncthing-tailscale-ip-wsl: the WSL2 node's tailnet address
WSL_IP=
# BWS secret syncthing-tailscale-ip-lgn5: the Windows host's tailnet address
LGN5_IP=
# BWS secret syncthing-tailscale-ip-homelab: the homelab server's tailnet address
HOMELAB_IP=
# BWS secret syncthing-tailscale-ip-dj15: the iPhone's tailnet address (SyncTrain and VaultSync)
DJ15_IP=
